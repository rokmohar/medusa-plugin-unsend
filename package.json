{
  "name": "@rokmohar/medusa-plugin-unsend",
  "version": "1.0.8",
  "description": "Unsend plugin for Medusa 2",
  "author": "Rok Mohar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rokmohar/medusa-plugin-unsend.git"
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-notification",
    "medusa-plugin-usend"
  ],
  "files": [
    ".medusa/server"
  ],
  "main": ".medusa/server/src/index.js",
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "medusa plugin:build",
    "lint": "eslint --ext .js,.ts src --cache --cache-strategy content",
    "lint:fix": "eslint --ext .js,.ts src --fix --cache --cache-strategy content",
    "typecheck": "tsc --noEmit --pretty --project tsconfig.json",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --cache --cache-strategy content --log-level warn",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --cache --cache-strategy content --log-level warn"
  },
  "dependencies": {
    "unsend": "1.4.2"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "^2.13.4",
    "@medusajs/cli": "^2.13.4",
    "@medusajs/framework": "^2.13.4",
    "@medusajs/icons": "^2.13.4",
    "@medusajs/medusa": "^2.13.4",
    "@medusajs/ui": "^4.1.4",
    "@swc/core": "^1.15.18",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "awilix": "^8.0.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16",
    "prettier": "^3.8.1",
    "react": "^18",
    "react-dom": "^18",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.57.1",
    "vite": "^5.4.21",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.13.4",
    "@medusajs/framework": "^2.13.4",
    "@medusajs/icons": "^2.13.4",
    "@medusajs/medusa": "^2.13.4",
    "@medusajs/ui": "^4.1.0",
    "awilix": "^8.0.1",
    "react": "^18",
    "react-dom": "^18"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22"
}
